{
  "name": "Retail Analytics",
  "dataColors": [
    "#0B6E4F",
    "#F18F01",
    "#2E86AB",
    "#C73E1D",
    "#6C757D",
    "#A23B72",
    "#7FB069",
    "#3B1F2B"
  ],
  "background": "#FFFFFF",
  "foreground": "#2B2D42",
  "tableAccent": "#0B6E4F",
  "good": "#0B6E4F",
  "neutral": "#F18F01",
  "bad": "#C73E1D",
  "maximum": "#0B6E4F",
  "center": "#F18F01",
  "minimum": "#C73E1D",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B6E4F"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2B2D42"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2B2D42"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5C6370"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8EE"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "center"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B6E4F"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#5C6370"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5C6370"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5C6370"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F5"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5C6370"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2.5,
            "showMarker": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5C6370"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#5C6370"
              }
            }
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Right",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5C6370"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#2B2D42"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            }
          }
        ]
      }
    }
  }
}